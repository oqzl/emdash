{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-test",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"cache": {
		"enabled": true
	},
	"vars": {
		"EMDASH_SITE_URL": "https://emdash-test.kenji-ishikawa.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-test",
			"migrations_dir": "../../migrations",
			"database_id": "206f4ece-5097-4f98-b3db-e831268e25d4"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-test-media"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
